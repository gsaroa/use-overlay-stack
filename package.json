{
  "name": "use-overlay-stack",
  "version": "0.1.0",
  "description": "One Sheet. One Dialog. One AlertDialog. Open any of them from anywhere in your React app without prop-drilling state or fighting nested z-index.",
  "keywords": [
    "react",
    "overlay",
    "dialog",
    "modal",
    "sheet",
    "alert-dialog",
    "shadcn",
    "radix",
    "hook",
    "singleton",
    "provider"
  ],
  "license": "MIT",
  "author": "Gurdeep Saroa",
  "homepage": "https://github.com/gsaroa/use-overlay-stack#readme",
  "bugs": "https://github.com/gsaroa/use-overlay-stack/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gsaroa/use-overlay-stack.git"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json && node -e \"require('fs').copyFileSync('dist/index.d.ts','dist/index.d.cts')\"",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "prepublishOnly": "pnpm run build",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm run build && changeset publish"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@changesets/cli": "^3.0.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "~30.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=18"
  }
}
